# ============================================================================
# MenuPilot environment
# Copy to .env.local (local) or set in your host's dashboard (production).
# Never commit a filled-in .env file.
#
# Legend:  [required]      must be set in production
#          [recommended]   strongly advised in production
#          [optional]      feature degrades gracefully without it
# ============================================================================

# --- Application ------------------------------------------------------------
APP_URL=http://localhost:3000                    # [required] public origin, no trailing slash
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use the bundled embedded PostgreSQL (local/CI).
# In production, point this at Supabase → Project Settings → Database →
# "Connection pooling" → Transaction mode (port 6543) connection string.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Use the pooler, not the direct 5432 host: serverless functions open a new
# connection per invocation and will exhaust direct connections.
DATABASE_URL=
DATABASE_POOL_MAX=10                             # [optional] per-instance pool size
DATABASE_PGLITE_DIR=.data/pglite                 # local/CI only

# --- Session ----------------------------------------------------------------
# Signs session tokens (HMAC) and realtime JWTs. Generate once:
#   openssl rand -base64 32
# Rotating this value signs every user out.
SESSION_SECRET=replace-with-a-32-byte-random-value   # [required]

# --- Supabase Storage -------------------------------------------------------
# local    -> files live in the database (works offline; not for production)
# supabase -> files live in a Supabase Storage bucket
STORAGE_DRIVER=local

SUPABASE_URL=                                    # [required for supabase storage]
SUPABASE_SERVICE_ROLE_KEY=                       # [required] SERVER ONLY — never expose to the browser
SUPABASE_ANON_KEY=                               # [optional] enables realtime
# Public base for rendering images, e.g.
#   https://<ref>.supabase.co/storage/v1/object/public
# Set this to render straight from the CDN. If unset, images are served through
# /api/media/... (which redirects to the CDN when STORAGE_DRIVER=supabase).
NEXT_PUBLIC_SUPABASE_STORAGE_URL=                # [recommended with supabase storage]

# --- Realtime ---------------------------------------------------------------
# Signing secret for realtime JWTs. On a Supabase project this is the project's
# JWT secret (Settings → API → JWT Settings) or a dedicated secret configured for
# Realtime. Leave unset to disable realtime: the UI polls instead.
REALTIME_JWT_SECRET=                             # [optional]
NEXT_PUBLIC_REALTIME_ENABLED=                    # [optional] true/false override

# --- Email ------------------------------------------------------------------
# Without these, invitations and password-reset links are generated and recorded
# in public.email_outbox with status 'skipped'. The UI says so; it never claims an
# email was delivered.
RESEND_API_KEY=                                  # [optional]
EMAIL_FROM="MenuPilot <no-reply@yourdomain.com>"  # [required if RESEND_API_KEY is set]

# --- Demo tenant ------------------------------------------------------------
# The seed runs in development and for a demo deployment. If unset, it generates a
# random owner password and writes it to .data/demo-credentials.txt (git-ignored).
# In production, set an explicit strong password or skip seeding entirely.
DEMO_OWNER_PASSWORD=                             # [optional]
DEMO_OWNER_EMAIL=owner@mati.demo                 # [optional]
DEMO_KITCHEN_EMAIL=kitchen@mati.demo             # [optional]
PLATFORM_ADMIN_EMAIL=admin@menupilot.demo        # [optional]
