# ============================================================================
# MenuPilot environment
# Copy to .env.local (local) or set in your host's dashboard (production).
# Never commit a filled-in .env file.
# ============================================================================

# --- Application -----------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL unset to use the bundled embedded PostgreSQL (local/CI).
# In production point this at your Supabase Postgres pooler connection string.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_PGLITE_DIR=.data/pglite

# --- Session ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Storage ---------------------------------------------------------------
# local    -> files live in the database and are served via /api/media
# supabase -> files live in a Supabase Storage bucket
STORAGE_DRIVER=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# --- Demo tenant -----------------------------------------------------------
# If unset, the seed generates a random owner password and writes it to
# .data/demo-credentials.txt (git-ignored).
# DEMO_OWNER_PASSWORD=
# DEMO_OWNER_EMAIL=owner@mati.demo
# DEMO_KITCHEN_EMAIL=kitchen@mati.demo
